    "@relix/api": "*",
    "@relix/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^5.0.3"
  }
}
