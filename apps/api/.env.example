# Optional copy for a non-Docker API process. The repo-root .env is what Compose and `npm run dev` read.
# See /.env.example for every variable. Placeholders only.

DATABASE_URL=postgresql://relix:relix@127.0.0.1:5432/relix
JWT_SECRET=dev-only-change-me
RELIX_WORKER_API_KEY=dev-worker-key
ADMIN_EMAIL=admin@relix.app
ADMIN_PASSWORD=change-me-please
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
RELIX_LEAD_SINK_EMAIL=
RELIX_BRIDGE_WEBHOOK=
RELIX_BRIDGE_WEBHOOK_AUTH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SOCIAL_PROVIDER=none
ZERNIO_API_KEY=
AYRSHARE_API_KEY=
AYRSHARE_PRIVATE_KEY=
AYRSHARE_PRIVATE_KEY_PATH=
AYRSHARE_DOMAIN=
PUBLIC_BASE_URL=
PORT=8787
SEED_ON_START=true
