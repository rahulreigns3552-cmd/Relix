# Copy to .env in the repo root before `docker compose up` or a non-Docker run.
# Never commit .env. Values below are local placeholders, not production secrets.

# Postgres (docker compose). The API reads DATABASE_URL, not these names.
POSTGRES_PASSWORD=relix

# Full URL the API uses. Inside compose this host name is `postgres`.
# On the host, point it at your local Postgres:
# DATABASE_URL=postgresql://relix:relix@127.0.0.1:5432/relix
DATABASE_URL=postgresql://relix:relix@127.0.0.1:5432/relix

# Signs the httpOnly session cookie. Use a long random string outside local dev.
JWT_SECRET=dev-only-change-me

# Sent by external workers in the X-Relix-Worker-Key header.
RELIX_WORKER_API_KEY=dev-worker-key

# First admin is created from these on seed / API boot. Password must be longer than 6 characters.
# This replaces the old hardcoded demo login. Change it before any shared deployment.
ADMIN_EMAIL=admin@relix.app
ADMIN_PASSWORD=change-me-please

# Browser origins allowed to call the API with cookies. Comma-separated. No trailing slash.
# Docker/nginx: http://localhost:8080
# Vite dev: http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Set true only behind HTTPS. Local http must stay false or the browser drops the cookie.
COOKIE_SECURE=false

# Ask Relix replies. Leave blank until you have a key; chat then explains that the key is missing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional inbox that receives completed Ask Relix exchanges for an external mailer.
RELIX_LEAD_SINK_EMAIL=

# Optional bridge wake-up webhook used when a chat or provision job is queued.
RELIX_BRIDGE_WEBHOOK=
RELIX_BRIDGE_WEBHOOK_AUTH=

# API listen port outside compose. Compose always uses 8787 inside the network.
PORT=8787

# Host port for the nginx site published by docker compose.
RELIX_PORT=8080

# Set to false to boot the API without importing data/ JSON (admin is still ensured).
SEED_ON_START=true
