# Copy to .env in the repo root. Never commit .env.
# Values below are local placeholders, not production secrets.
# Required keys are checked by `npm run check-env`.

# --- Required to boot ---

# Postgres password used by docker compose. The API reads DATABASE_URL.
POSTGRES_PASSWORD=relix

# Host Postgres. Compose overrides this with the `postgres` service hostname.
DATABASE_URL=postgresql://relix:relix@127.0.0.1:5432/relix

# Signs session cookies and approval links. Use a long random string outside local dev.
JWT_SECRET=dev-only-change-me

# Shared by the API and the in-repo worker (header X-Relix-Worker-Key).
RELIX_WORKER_API_KEY=dev-worker-key

# Seeded admin. Password must be longer than 6 characters. Not reset if the user already exists.
ADMIN_EMAIL=admin@relix.app
ADMIN_PASSWORD=change-me-please

# --- Browser and ports ---

# Comma-separated origins allowed to call the API with cookies. No trailing slash.
# Docker site: http://localhost:8080
# Vite dev: http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# true only behind HTTPS. Local http must stay false or the browser drops the cookie.
COOKIE_SECURE=false

# API port on the host. Compose always uses 8787 inside the network.
PORT=8787

# Where the worker calls the API. Compose sets http://api:8787. Vite proxies this URL.
RELIX_API_URL=http://127.0.0.1:8787

# Host port for the Nginx site.
RELIX_PORT=8080

# Public origin used in approval links and OAuth redirects.
# Docker: http://localhost:8080. Vite: http://localhost:5173
PUBLIC_BASE_URL=

# Import data/ on an empty database. The admin is always ensured.
SEED_ON_START=true

# Optional separate database for `npm test`. Defaults to relix_test on localhost.
# TEST_DATABASE_URL=postgresql://relix:relix@127.0.0.1:5432/relix_test

# --- Worker (in this repo; nothing outside is required) ---

# Wake URL. Leave empty to use the in-repo worker.
# Compose default: http://worker:8790/wake
# Host default when empty: http://127.0.0.1:8790/wake
RELIX_BRIDGE_WEBHOOK=
# Must match RELIX_WORKER_API_KEY when set. Empty uses RELIX_WORKER_API_KEY.
RELIX_BRIDGE_WEBHOOK_AUTH=

WORKER_PORT=8790
WORKER_INTERVAL_SECONDS=60

# Approved posts are sent only when this is true.
WORKER_PUBLISH_ENABLED=false

# OpenAI image edits run only when this is true. Needs OPENAI_API_KEY and brand reference images.
WORKER_IMAGEGEN_ENABLED=false

# --- OpenAI (optional; chat and images skip when empty) ---

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Email over SMTP (optional; lead and approval mail skip when empty) ---
# A Gmail app password works: host smtp.gmail.com, port 587, user is the Gmail address.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Inbox for finished Ask Relix chats. Approval mail goes to the project owner instead.
RELIX_LEAD_SINK_EMAIL=

# --- Posting provider (optional; none makes no network calls) ---

# none | zernio | ayrshare
SOCIAL_PROVIDER=none
ZERNIO_API_KEY=
AYRSHARE_API_KEY=
AYRSHARE_DOMAIN=
# PEM on the server, or paste the key in AYRSHARE_PRIVATE_KEY. Do not commit either.
AYRSHARE_PRIVATE_KEY_PATH=
AYRSHARE_PRIVATE_KEY=
